--notification shit
local notifications = {}
local notifheight = 60
local notifwidth = 300
local notifspacing = 10

local function notify(title, description, duration)
    duration = duration or 3
    
    local screenx = game:GetService("GuiService"):GetScreenResolution().X
    local targetx = screenx - notifwidth - 20
    
    local notif = Drawing.new("Square")
    notif.Size = Vector2.new(notifwidth, notifheight)
    notif.Position = Vector2.new(screenx + 50, 20)
    notif.Color = Color3.fromRGB(30, 30, 35)
    notif.Filled = true
    notif.Transparency = 0.95
    notif.Visible = true
    
    local border = Drawing.new("Square")
    border.Size = Vector2.new(notifwidth, notifheight)
    border.Position = notif.Position
    border.Color = Color3.fromRGB(60, 60, 65)
    border.Filled = false
    border.Thickness = 2
    border.Transparency = 1
    border.Visible = true
    
    local progress = Drawing.new("Square")
    progress.Size = Vector2.new(3, notifheight)
    progress.Position = Vector2.new(notif.Position.X, notif.Position.Y)
    progress.Color = Color3.fromRGB(175, 218, 230)
    progress.Filled = true
    progress.Transparency = 1
    progress.Visible = true
    
    local titletext = Drawing.new("Text")
    titletext.Text = title
    titletext.Size = 15
    titletext.Position = Vector2.new(notif.Position.X + 15, notif.Position.Y + 8)
    titletext.Color = Color3.fromRGB(255, 255, 255)
    titletext.Outline = true
    titletext.Visible = true
    
    local desctext = Drawing.new("Text")
    desctext.Text = description
    desctext.Size = 13
    desctext.Position = Vector2.new(notif.Position.X + 15, notif.Position.Y + 28)
    desctext.Color = Color3.fromRGB(200, 200, 200)
    desctext.Outline = true
    desctext.Visible = true
    
    local notifdata = {notif, border, titletext, desctext, progress, sliding = true}
    table.insert(notifications, notifdata)
    
    local slidetime = 0.3
    local starttime = tick()
    local startx = screenx + 50
    
    local slideconnection
    slideconnection = rs.RenderStepped:Connect(function()
        local elapsed = tick() - starttime
        local alpha = math.min(elapsed / slidetime, 1)
        local smoothalpha = alpha * alpha * (3 - 2 * alpha)
        
        local currentx = startx + (targetx - startx) * smoothalpha
        
        for i, n in pairs(notifications) do
            local ypos = 20 + ((i - 1) * (notifheight + notifspacing))
            
            if n.sliding and n == notifdata then
                n[1].Position = Vector2.new(currentx, ypos)
                n[2].Position = Vector2.new(currentx, ypos)
                n[3].Position = Vector2.new(currentx + 15, ypos + 8)
                n[4].Position = Vector2.new(currentx + 15, ypos + 28)
                n[5].Position = Vector2.new(currentx, ypos)
            else
                n[1].Position = Vector2.new(targetx, ypos)
                n[2].Position = Vector2.new(targetx, ypos)
                n[3].Position = Vector2.new(targetx + 15, ypos + 8)
                n[4].Position = Vector2.new(targetx + 15, ypos + 28)
                n[5].Position = Vector2.new(targetx, ypos)
            end
        end
        
        if alpha >= 1 then
            notifdata.sliding = false
            slideconnection:Disconnect()
        end
    end)
    
    local progressconnection
    local progressstart = tick()
    
    task.delay(slidetime, function()
        progressconnection = rs.RenderStepped:Connect(function()
            local elapsed = tick() - progressstart
            local progresspercent = math.min(elapsed / duration, 1)
            
            progress.Size = Vector2.new(3, notifheight * (1 - progresspercent))
            
            if progresspercent >= 1 then
                progressconnection:Disconnect()
            end
        end)
    end)
    
    task.delay(duration + slidetime, function()
        for i, n in pairs(notifications) do
            if n[1] == notif then
                table.remove(notifications, i)
                break
            end
        end
        
        if progressconnection then
            progressconnection:Disconnect()
        end
        
        notif:Remove()
        border:Remove()
        titletext:Remove()
        desctext:Remove()
        progress:Remove()
        
        for i, n in pairs(notifications) do
            local ypos = 20 + ((i - 1) * (notifheight + notifspacing))
            n[1].Position = Vector2.new(targetx, ypos)
            n[2].Position = Vector2.new(targetx, ypos)
            n[3].Position = Vector2.new(targetx + 15, ypos + 8)
            n[4].Position = Vector2.new(targetx + 15, ypos + 28)
            n[5].Position = Vector2.new(targetx, ypos)
        end
    end)
end

