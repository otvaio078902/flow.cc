-- bullet tracer
local function makeTrail(p)
    if not tracersenabled then return end
    if not (p:IsA("BasePart") and p.Name == "Tracer") or p:FindFirstChild("x") then
        return
    end
    
    local m = Instance.new("BoolValue")
    m.Name = "x"
    m.Parent = p
    
    local tc = Instance.new("Part")
    tc.Name = "tc_" .. p.Name
    tc.Anchored = true
    tc.CanCollide = false
    tc.CanTouch = false
    tc.CanQuery = false
    tc.Transparency = 1
    tc.Size = Vector3.new(0.1, 0.1, 0.1)
    tc.Position = p.Position
    tc.Parent = workspace
    
    local t = Instance.new("Trail")
    t.Name = "t"
    t.Parent = tc
    
    local a0 = Instance.new("Attachment")
    a0.Name = "ta0"
    a0.Parent = tc
    
    local a1 = Instance.new("Attachment")
    a1.Name = "ta1"
    a1.Parent = tc
    
    t.Attachment0 = a0
    t.Attachment1 = a1
    
    local tracerData = {
        part = p,
        trail = t,
        container = tc,
        a0 = a0,
        a1 = a1
    }
    table.insert(activeTracers, tracerData)
    
    local s = p.Size
    local o = s.Y * tracerlength / 2
    
    a0.WorldPosition = p.Position + Vector3.new(0, o, 0)
    a1.WorldPosition = p.Position + Vector3.new(0, -o, 0)
    
    t.WidthScale = NumberSequence.new({
        NumberSequenceKeypoint.new(0, s.X * tracerwidth),
        NumberSequenceKeypoint.new(1, s.X * tracerwidth * 0.3)
    })
    t.LightEmission = tracerglow
    t.Lifetime = tracerlifetime
    t.MinLength = 0.2
    t.Color = ColorSequence.new(tracercolor)
    t.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.2),
        NumberSequenceKeypoint.new(0.5, 0.5),
        NumberSequenceKeypoint.new(1, 1)
    })
    t.TextureLength = 5
    
    local cn
    cn = rs.Heartbeat:Connect(function()
        if p and p.Parent then
            local s = p.Size
            local o = s.Y * tracerlength / 2
            a0.WorldPosition = p.Position + Vector3.new(0, o, 0)
            a1.WorldPosition = p.Position + Vector3.new(0, -o, 0)
        else
            cn:Disconnect()
            for i, data in ipairs(activeTracers) do
                if data == tracerData then
                    table.remove(activeTracers, i)
                    break
                end
            end
            delay(tracerlifetime, function()
                tc:Destroy()
            end)
        end
    end)
    
    tc.Destroying:Connect(function()
        if cn then
            cn:Disconnect()
        end
        for i, data in ipairs(activeTracers) do
            if data == tracerData then
                table.remove(activeTracers, i)
                break
            end
        end
    end)
end

workspace.DescendantAdded:Connect(function(d)
    if d:IsA("BasePart") and d.Name == "Tracer" then
